# E-BARANGAY: Environment Variables Configuration
# Exclusively for Barangay Mambugan, City of Antipolo, Rizal

# Supabase Credentials (from your Supabase project dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Google Gemini API Key for hybrid LLM triage enrichment (fallback engine is built-in)
GEMINI_API_KEY=

# Local / Scope Constants
NEXT_PUBLIC_BARANGAY_NAME=Barangay Mambugan
NEXT_PUBLIC_CITY_NAME=City of Antipolo, Rizal
NEXT_PUBLIC_COMMUNITY_POPULATION=55,664
